{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      ".read": "auth != null",
      "$sid": {
        "host": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || !data.child('t').exists() || data.child('t').val() < now - 10000)",
          ".validate": "newData.child('uid').val() === auth.uid && (!newData.child('t').exists() || (newData.child('t').isNumber() && newData.child('t').val() <= now))"
        },
        "roles": {
          "$role": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || (data.child('claimedAt').val() < now - 15000 && (!root.child('sessions').child($sid).child('cars').child($role).child('t').exists() || root.child('sessions').child($sid).child('cars').child($role).child('t').val() < now - 15000)))",
            ".validate": "($role === 'lead' || $role === 'mid' || $role === 'tail') && newData.child('uid').val() === auth.uid && newData.child('claimedAt').isNumber()"
          }
        },
        "cars": {
          "$role": {
            ".write": "auth != null",
            ".validate": "($role === 'lead' || $role === 'mid' || $role === 'tail') && newData.hasChildren(['s', 'v', 'status', 'npc', 't'])",
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "v": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "status": {
              ".validate": "newData.val() === 'driving' || newData.val() === 'stopped'"
            },
            "npc": {
              ".validate": "newData.isBoolean()"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "meta": {
          ".write": "auth != null",
          "tailLag": {
            ".validate": "newData.isNumber() && newData.val() >= 0.2 && newData.val() <= 1"
          },
          "resetAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "alerts": {
          ".write": "auth != null && !newData.exists()",
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['type', 'role', 't'])",
            "type": {
              ".validate": "newData.val() === 'pullover' || newData.val() === 'resume'"
            },
            "role": {
              ".validate": "newData.val() === 'lead' || newData.val() === 'mid' || newData.val() === 'tail'"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ptt": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('startedAt').val() < now - 30000)",
          ".validate": "newData.hasChildren(['role', 'uid', 'startedAt']) && newData.child('uid').val() === auth.uid",
          "role": {
            ".validate": "newData.val() === 'lead' || newData.val() === 'mid' || newData.val() === 'tail'"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 5000"
          },
          "$other": {
            ".validate": false
          }
        },
        "clips": {
          ".write": "auth != null && !newData.exists()",
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('t').val() < now - 30000))",
            ".validate": "newData.hasChildren(['role', 'uid', 'mime', 'b64', 't'])",
            "role": {
              ".validate": "newData.val() === 'lead' || newData.val() === 'mid' || newData.val() === 'tail'"
            },
            "uid": {
              ".validate": "newData.isString()"
            },
            "mime": {
              ".validate": "newData.isString() && newData.val().length < 64"
            },
            "b64": {
              ".validate": "newData.isString() && newData.val().length <= 200000"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
